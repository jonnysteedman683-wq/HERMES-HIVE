# GEMINI_API_KEY: Required for the Gemini LLM backend (default).
# Set to a real key (not the placeholder) to use Gemini.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. Set to use OpenAI as the LLM backend instead of Gemini.
# Requires LLM_PROVIDER=openai (see below).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_BASE_URL: Alternate endpoint for OpenAI-compatible APIs (e.g. Azure, OAI proxy).
# Leave unset to use the default https://api.openai.com/v1.
# OPENAI_BASE_URL="https://api.openai.com/v1"

# OPENAI_MODEL: Model to use when LLM_PROVIDER=openai. Defaults to gpt-4o-mini.
# OPENAI_MODEL="gpt-4o-mini"

# LLM_PROVIDER: Which backend to use. "gemini" (default) or "openai".
# LLM_PROVIDER="gemini"

# APP_URL: The URL where this applet is hosted.
